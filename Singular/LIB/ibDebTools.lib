LIB "MapleInterface.lib";
LIB "integralbasis.lib";
LIB "atkins.lib"; // used for square root, can we get rid of this?
//LIB "random.lib";
//LIB "sing.lib";

proc ibComp(poly f, list #){
  system("--ticks-per-sec", 100);
  int t = timer;
  list options;
  int hMet = 1;   // Singular kernel hensel lifting

  "Options available: ";
  "  atOrigin - integral basis at the origin";
  "  modular - use modular algorithms (default)";
  "  nonModular - do not use modular algorithms";
  "  singular - run only Singular";
  "  maple - run only Maple";

  "Selected options: ";
  if(optionOn(#, "atOrigin"))
  {
    "  atOrigin - integral basis at the origin";
    options = list("atOrigin");
  } else
  {
    "  full integral basis";
    "  No special algorithm for the nodal locus.";
    options = list("simple");
  }

  if(optionOn(#, "nonModular"))
  {
    "  nonModular - do not use modular algorithms";
    options = insert(options, "nonModular");
  } else
  {
    "  modular - use modular algorithms";
    options = insert(options, "modular");
  }
  if(optionOn(#, "normal"))
  {
    "  normal algorithm";
    options = insert(options, "normal");
  }   
  
  if(optionOn(#, "locLoc"))
  {
    "  locLoc algorithm";
    options = insert(options, "locLoc");
  }   
  if(optionOn(#, "noOpti"))
  {
    "  not optimal algorithm (option used only for debug)";
    options = insert(options, "noOpti");
  } 
  "---";

  if(optionOn(#, "maple") == 0)
  { 
    list ib = integralBasis(f, 2, options);

    int t1 = timer - t;
    if(hMet == 2)
    {
      "Time Singular Library: ", t1, "/ 100 seg";
    } else
    {
      "Time Singular Kernel: ", t1, "/ 100 seg";
    }
  }
  if(optionOn(#, "singular") == 0)
  {
    if(optionOn(#, "atOrigin"))
    {
      list l = locIntegralBasisFromMaple(f);
    } else
    {
      list l = integralBasisFromMaple(f) ;
    }
  }
  if(optionOn(#, "maple") == 0)
  {
    "Time Singular: ", t1, "/ 100 seg";
  }
  if(optionOn(#, "singular") == 0)
  {
    "Time Maple: ", l[3], "seg";
  }
  if(optionOn(#, "singular") == 1)
  {
    return(ib);
  }
  if(optionOn(#, "maple") == 1)
  {
    return(l);
  }

  if((optionOn(#, "maple") == 0) and (optionOn(#, "singular") == 0))
  {
    "Comparing outputs...";
    int s1 = (size(reduce(ib[1], groebner(l[1]))) == 0);
    s1;
    if(s1 == 0){
      "Different output! Check...";
      reduce(ib[1], groebner(l[1]));
      ~;
    }
    int s2 = (size(reduce(l[1], groebner(ib[1]))) == 0);
    s2;
    if(s2 == 0){
      "Different output! Check...";
      reduce(l[1], groebner(ib[1]));
      ~;
    }
    "Same output?", s1 * s2;
    return(l);
  }
}

///////////////////////////////////////////////////////////////////////////////

proc ibCompNormal(poly f, list #){
  int hMet = 2;
  list options;
  "Options: ";

  if(optionOn(#, "atOrigin"))
  {
    "Integral basis at the origin.";
    options = list("atOrigin");
  } else
  {
    "Full integral basis.";
    options = list("simple");
    "No special algorithm for the nodal case.";
  }

  ideal I = f;
  list optN = insert(options, "normal");

  int t = timer;
  list ib1 = integralBasis(f, 2, optN);
  int t1 = timer - t;
  "Time Normal: ", t1;

  int t2 = timer;
  list ib2 = integralBasis(f, 2, options);

  "Time IntegralBasis: ", timer - t2;

  "Comparing outputs...";
  ideal nor = changeDenominator(ib1[1], ib1[2], ib2[2], f);
  int s1 = (size(reduce(ib2[1], groebner(nor))) == 0);
  s1;
  int s2 = (size(reduce(nor, groebner(ib2[1]))) == 0);
  s2;
  "Same output?", s1 * s2;
  if(s1 * s2 == 0){
    "Different output! Check...";
    ~;
  }
  return(ib1);
}

